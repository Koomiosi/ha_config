{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.info_2",
  "data": {
    "config": {
      "views": [
        {
          "title": "Info",
          "path": "info",
          "background": "center / cover no-repeat url(\"/local/bg7.jpg\")",
          "icon": "mdi:tablet-dashboard",
          "theme": "default",
          "layout": {
            "width": 400,
            "max_cols": 4
          },
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "custom:apexcharts-card",
                  "graph_span": "27h",
                  "experimental": {
                    "color_threshold": true
                  },
                  "show": {
                    "last_updated": true
                  },
                  "header": {
                    "title": "Electricity price",
                    "show": true,
                    "show_states": true,
                    "colorize_states": true
                  },
                  "span": {
                    "start": "day"
                  },
                  "yaxis": [
                    {
                      "min": 0,
                      "decimals": 2,
                      "apex_config": {
                        "forceNiceScale": true
                      }
                    }
                  ],
                  "now": {
                    "show": true,
                    "label": "Now"
                  },
                  "series": [
                    {
                      "entity": "sensor.shf_electricity_price_now",
                      "show": {
                        "in_header": false,
                        "extremas": true,
                        "legend_value": false
                      },
                      "type": "column",
                      "color": "lightgray",
                      "float_precision": 2,
                      "unit": "c/kWh",
                      "data_generator": "return entity.attributes.data.map((d, index) => {\n  return [d[\"Timestamp\"]*1000, d[\"TotalPrice\"]*100];\n});\n",
                      "color_threshold": [
                        {
                          "value": 0,
                          "color": "368f39"
                        },
                        {
                          "value": 10,
                          "color": "a3b34d"
                        },
                        {
                          "value": 20,
                          "color": "ffd57e"
                        },
                        {
                          "value": 30,
                          "color": "f18c56"
                        },
                        {
                          "value": 40,
                          "color": "de425b"
                        }
                      ]
                    },
                    {
                      "entity": "sensor.shf_electricity_price_now",
                      "show": {
                        "in_header": true,
                        "header_color_threshold": true,
                        "in_chart": false
                      },
                      "type": "line",
                      "color": "lightgray",
                      "float_precision": 2,
                      "stroke_width": 0,
                      "transform": "return x*100",
                      "unit": "c/kWh",
                      "color_threshold": [
                        {
                          "value": 0,
                          "color": "368f39"
                        },
                        {
                          "value": 10,
                          "color": "a3b34d"
                        },
                        {
                          "value": 20,
                          "color": "ffd57e"
                        },
                        {
                          "value": 30,
                          "color": "f18c56"
                        },
                        {
                          "value": 40,
                          "color": "de425b"
                        }
                      ]
                    }
                  ],
                  "card_mod": {
                    "style": "ha-card {\n  background: rgba(0, 0, 0, 0.2);\n  color: white;\n  border-radius: 12px;\n}\n"
                  }
                }
              ]
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "markdown",
                  "content": "## 📅 {% set weekdays = ['ma', 'ti', 'ke', 'to', 'pe', 'la', 'su'] %} {% set weekday = weekdays[now().weekday()] %} {{ weekday }} {{ now().day }}.{{ now().month }}.{{ now().year }}\n🕒 {{ states('sensor.time') }}\n",
                  "text_only": true,
                  "card_mod": {
                    "style": "ha-card {\n  background: rgba(0, 0, 0, 0.2);\n  color: white;\n  padding: 16px;\n  border-radius: 12px;\n  text-align: center\n}\n"
                  }
                },
                {
                  "show_current": true,
                  "show_forecast": true,
                  "type": "weather-forecast",
                  "entity": "weather.forecast_home",
                  "forecast_type": "daily",
                  "forecast_slots": 6,
                  "card_mod": {
                    "style": "ha-card {\n  background: rgba(0, 0, 0, 0.2);\n  color: white;\n  padding: 16px;\n  border-radius: 12px;\n  text-align: center\n}\n"
                  }
                }
              ]
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "horizontal-stack",
                  "cards": [
